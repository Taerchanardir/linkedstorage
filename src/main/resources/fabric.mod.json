{
  "schemaVersion": 1,
  "id": "linkedstorage",
  "version": "${version}",
  "name": "Linked Storage",
  "description": "Linkable storage's!",
  "authors": [
    "kyrptonaught"
  ],
  "contact": {
    "homepage": "https://github.com/kyrptonaught/linkedstorage",
    "sources": "https://github.com/kyrptonaught/linkedstorage",
    "issues": "https://github.com/kyrptonaught/linkedstorage/issues"
  },
  "license": "MIT",
  "icon": "assets/linkedstorage/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.kyrptonaught.linkedstorage.LinkedStorageMod"
    ],
    "client": [
      "net.kyrptonaught.linkedstorage.LinkedStorageModClient"
    ],
    "quickshulker": [
      "net.kyrptonaught.linkedstorage.compat.Quickshulker"
    ]
  },
  "mixins": [
    "linkedstorage.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "java": ">=17",
    "minecraft": "${minecraft_version}"
